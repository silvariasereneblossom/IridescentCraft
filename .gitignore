mods/*.jar
# Keep custom IridescentCraft jars (coremods and data mods)
!mods/iridescent_origins-*.jar
!mods/iridescent_codex_data.jar
!mods/iridescent_biomes-*.jar
!mods/iridescent_modular_spells-*.jar
!mods/zeta_racefix-*.jar
!mods/mek_walkable_cables-*.jar
# Bytecode-patched third-party jars — same filename as the original
# download, but with our edits. Downloader skips if file exists; these
# exemptions make sure git tracks them and the sync ships them.
!mods/class-artifacts-forge-*.jar
resourcepacks/
!**/config/paxi/resourcepacks/
!**/config/paxi/resourcepacks/**
shaderpacks/*
!shaderpacks/*.zip
!**/shaderpacks/*.zip
saves/

# Runtime-generated world / map data (regenerates on play, never commit)
.minecraft/journeymap/
.minecraft/region/
.minecraft/placeholderlevel/
.minecraft/backups/
.minecraft/world/
.minecraft/logs/
.minecraft/crash-reports/
.minecraft/modernfix/
.minecraft/local/
.minecraft/poi/
.minecraft/moddata/
.minecraft/immersive_library/
.minecraft/prettypipesprefs/
.minecraft/usercache.json
.minecraft/usernamecache.json
.minecraft/banned-*.json
.minecraft/ops.json
.minecraft/whitelist.json
# Runtime crash logs shipped by testers — keep committed under TesterLogs/ but
# block loose crash-logs that accumulate at distro root
.minecraft/server_distribution/logs/
.minecraft/server_distribution/crash-reports/
.minecraft/distribution/client/logs/
.minecraft/distribution/client/crash-reports/

*.zip
!global_packs/required_data/*.zip
!server_distribution/global_packs/required_data/*.zip
!distribution/client/global_packs/required_data/*.zip
!config/paxi/datapacks/*.zip
!server_distribution/config/paxi/datapacks/*.zip
!distribution/client/config/paxi/datapacks/*.zip
*.rar


# Loot audit working artifacts (extracted mod JARs)
dungeons_plus/
explorify/
idas/
moogs_end/
repurposed/
stalwart/
structory/
structory_towers/
valhelsia/
when_dungeons/
yungs_*/
*.jar
!minecraft/**/*.jar
# Patched third-party jars shipped alongside the downloaded originals.
# The earlier 'mods/*.jar + !mods/xxx.jar' block only matches
# top-level mods/, not the three-distro mods/ paths — and the later
# blanket *.jar rule above catches them again. These explicit rules
# re-exempt the patched jars across all three distros.
!.minecraft/mods/class-artifacts-forge-*.jar
!.minecraft/server_distribution/mods/class-artifacts-forge-*.jar
!.minecraft/distribution/client/mods/class-artifacts-forge-*.jar
.claude/worktrees/

# Per-host PAT for the auto log-push flow. Never commit.
.icraft_token
**/.icraft_token

# Per-launch sync sentinel written by prism_prelaunch.bat (H2/F2) + its
# scratch temp. Local launch state only; `reset --hard` must not fight it.
.minecraft/.icraft_sync_status.json
**/.icraft_sync_status.json
.minecraft/.icraft_behind.tmp
**/.icraft_behind.tmp

# Forge install artifacts - libraries/ should never be committed.
# These get generated by the Forge installer at runtime on server install.
# Pre-2026-05-25: partial libraries/ leaked into the repo from migration,
# silently sabotaging server installs (Phase 2 install-if-missing check
# saw the partial dir + skipped reinstall, Java launch then failed
# trying to load classes from jars that didn't exist).
.minecraft/libraries/
.minecraft/server_distribution/libraries/
.minecraft/distribution/client/libraries/

# Mesa3D software-OpenGL DLLs that ride alongside icraft-gui.exe on
# GPU-less server VMs (RDP basic display driver, no GL 2.0+). Dropped
# in by iridescent-launcher/scripts/fetch-mesa.ps1 -- libgallium_wgl.dll
# alone is 59 MB and Mesa releases monthly, so not worth committing.
# New server installs run fetch-mesa.ps1 once; updates are out-of-band.
.minecraft/server_distribution/opengl32.dll
.minecraft/server_distribution/libgallium_wgl.dll
.minecraft/distribution/client/opengl32.dll
.minecraft/distribution/client/libgallium_wgl.dll

# Lessons-learned auto-capture state + logs. State file persists across
# pushes to track last-scanned-sha + push-count-since-last-QA. Logs are
# per-invocation diagnostics. Both are local-only operator artifacts;
# never committed.
.minecraft/dev/.lessons-state.json
.minecraft/dev/.lessons-scan.log
.minecraft/dev/.lessons-qa.log
