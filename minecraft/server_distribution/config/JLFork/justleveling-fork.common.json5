	// =================================================================
	// SKILL PARAMETERS
	// =================================================================
	// Many skills are replaced by KubeJS implementations (mastery_tax.js
	// and justleveling_skills.js). Disabled skills have requiredLevel: 999.
	// See wiki for the full IridescentCraft skill design.
	// =================================================================

	// --- STR: One Handed (KEEP) — +50% one-handed damage ---
	oneHandedAmplifier: 0.5,
	// --- STR: Fighting Spirit → Hemorrhage (DISABLED, KubeJS reimpl) ---
	fightingSpiritBoost: 0,
	fightingSpiritDuration: 0,
	// --- STR: Berserker → True Strength (DISABLED, KubeJS reimpl) ---
	berserkerPercent: 0,

	// --- CON: Athletics → Hearty Meals (DISABLED, KubeJS reimpl) ---
	athleticsModifier: 0,
	// --- DEF: Lion Heart (DISABLED, KubeJS reimpl — DR scales w/ missing HP) ---
	lionHeartPercent: 0,

	// --- DEX: Quick Reposition → Fleet of Foot (DISABLED, KubeJS reimpl) ---
	quickRepositionBoost: 0,
	quickRepositionDuration: 0,
	// --- DEX: Stealth Mastery → Rapid Fire (DISABLED, KubeJS reimpl) ---
	stealthMasteryUnSneakPercent: 0,
	stealthMasterySneakPercent: 0,
	stealthMasteryModifier: 0,

	// --- DEF: Counter Attack → Turtle Shield (DISABLED, KubeJS reimpl) ---
	counterAttackDuration: 0,
	counterAttackPercent: 0,
	// --- DEF: Diamond Skin → Lion Heart (DISABLED, KubeJS reimpl) ---
	diamondSkinBoost: 0,
	diamondSkinSneakAmplifier: 0,

	// --- INT: Haggler (KEEP) — 20% cheaper villager trades ---
	hagglerPercent: 20,
	// --- INT: Alchemy Manipulation → Potion Manipulation (KEEP) — +1 amplifier ---
	alchemyManipulationAmplifier: 1.0,

	// --- BLD: Obsidian Smasher (KEEP) — 10x obsidian break speed ---
	obsidianSmasherModifier: 10.0,
	// --- BLD: Treasure Hunter → Resourceful (DISABLED, KubeJS reimpl — 8% craft refund) ---
	treasureHunterProbability: 0,
	treasureHunterItemList: [],
	// --- BLD: Convergence → Master Craftsman (DISABLED, KubeJS reimpl — +12% craft refund) ---
	convergenceProbability: 0,

	// --- MAG: Safe Port → Arcane Efficiency (DISABLED, KubeJS reimpl) ---
	// --- MAG: Life Eater → Spell Attunement (DISABLED, KubeJS reimpl) ---
	lifeEaterModifier: 0,

	// --- LCK: Critical Roll → Lucky Strike (KEEP, tuned) — 20% chance for 120% damage ---
	criticalRoll6Modifier: 1.20,
	criticalRoll1Probability: 0,
	// --- LCK: Lucky Drop → Fortune's Favor (KEEP) — passive Luck + Fortune I ---
	luckyDropModifier: 2.0,
	luckyDropProbability: 10,
	// --- LCK: Limit Breaker → Motherlode (DISABLED, KubeJS reimpl — 0.01% 5x mining) ---
	limitBreakerAmplifier: 0,
	limitBreakerProbability: 0,

	// =================================================================
	// REQUIRED LEVELS — Standardized to 10/20/30 per aptitude
	// =================================================================
	// STR
	oneHandedRequiredLevel: 10,
	fightingSpiritRequiredLevel: 20,
	berserkerRequiredLevel: 30,
	// CON (uses Athletics/TurtleShield/LionHeart slots)
	athleticsRequiredLevel: 10,
	turtleShieldRequiredLevel: 20,
	lionHeartRequiredLevel: 30,
	// DEX (uses QuickReposition/StealthMastery/CatEyes slots)
	quickRepositionRequiredLevel: 10,
	stealthMasteryRequiredLevel: 20,
	catEyesRequiredLevel: 30,
	// DEF (uses SnowWalker/CounterAttack/DiamondSkin slots)
	snowWalkerRequiredLevel: 10,
	counterattackRequiredLevel: 20,
	diamondSkinRequiredLevel: 30,
	// INT
	scholarRequiredLevel: 999,
	hagglerRequiredLevel: 10,
	alchemyManipulationRequiredLevel: 20,
	// BLD
	obsidianSmasherRequiredLevel: 10,
	treasureHunterRequiredLevel: 20,
	convergenceRequiredLevel: 30,
	// MAG
	safePortRequiredLevel: 10,
	lifeEaterRequiredLevel: 20,
	wornholeStorageRequiredLevel: 30,
	// LCK
	criticalRollRequiredLevel: 10,
	luckyDropRequiredLevel: 20,
	limitBreakerRequiredLevel: 30
