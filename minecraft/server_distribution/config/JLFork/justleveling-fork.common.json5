{
	// DON'T CHANGE THIS, REQUIRED TO AUTOMATICALLY TRY TO PORT LOCK ITEMS FROM THE OLD CONFIG.
	usingNewConfig: true,
	// Should the mod automatically check for updates on load?
	checkForUpdates: true,
	// Aptitudes Max Level
	aptitudeMaxLevel: 32,
	// Global max level, the global level is calculated summing all aptitudes level, so if this is set to 32 players will be able to only maximize 1 skill.
	playersMaxGlobalLevel: 256,
	// First aptitudes level cost
	aptitudeFirstCostLevel: 5,
	// Show potions overlay over skills
	showPotionsHud: true,
	// If true, locked items will be automatically dropped from player hands
	dropLockedItems: false,
	// TAC:Zero have a special id system, so if you wanna get the id to restrict you need to enable this and shoot.
	logTaczGunNames: false,
	// If Iron's Spells 'n Spellbooks is present, it will log the spells id's on cast required to restrict them.
	logSpellIds: false,
	// If true this will display the player titles as prefixes when a player chat.
	displayTitlesAsPrefix: true,
	// Attack Damage passive value at max level
