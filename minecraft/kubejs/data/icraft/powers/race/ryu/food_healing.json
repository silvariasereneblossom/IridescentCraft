{
  "type": "origins:action_over_time",
  "interval": 40,
  "entity_action": {
    "type": "origins:if_else",
    "condition": {
      "type": "origins:and",
      "conditions": [
        { "type": "origins:food_level", "comparison": ">=", "compare_to": 18 },
        { "type": "origins:health", "comparison": "<", "compare_to": 1.0 }
      ]
    },
    "if_action": {
      "type": "origins:heal",
      "amount": 1
    }
  },
  "name": "Draconic Regeneration",
  "description": "When well-fed, you regenerate health faster than normal."
}
