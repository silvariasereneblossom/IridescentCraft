{
  "_comment": "Source wiki/ files -> public GitHub Wiki page names. Used by tools/sync-wiki.py + .github/workflows/sync-wiki.yml. Add new entries here when a wiki page is added or renamed.",
  "_paths": {
    "_comment": "Paths in 'src' are repo-root-relative (i.e. start with .minecraft/). Paths in 'dst' are bare wiki page filenames (no directory prefix; the wiki repo is flat).",
