    "(mods/custom.md": "(Custom-Mods",
    "(meta/style-guide.md": "(Style-Guide",
    "(meta/credits.md": "(Credits",
    "(known-issues/tracker.md": "(Known-Issues",
    "(protocols/8-client-sync.md": "(Client-Sync-Protocol",

    "_comment_bare_filename": "Bare filenames used by inter-page links within the same directory (e.g. master.md linking to changelog.md).",
    "(master-appendix.md": "(Master-Design-Appendix",
    "(master.md": "(Master-Design-Document",
    "(changelog.md)": "(Design-Changelog)",
    "(changelog.md#": "(Design-Changelog#",
    "(iridescent-modular-spells-tetra-migration.md": "(Iridescent-Modular-Spells-Tetra-Migration",
    "(../home.md)": "(Home)",
    "(../home.md#": "(Home#",
    "(../systems/controls.md": "(Controls",

    "_comment_inline_code": "`identifier`-style references in body text.",
    "`design/master-appendix.md`": "`Master-Design-Appendix`",
    "`design/master.md`": "`Master-Design-Document`",
    "`design/changelog.md`": "`Design-Changelog`",
    "`master-appendix.md`": "`Master-Design-Appendix`",
    "`master.md`": "`Master-Design-Document`",
    "`changelog.md`": "`Design-Changelog`",
    "`../home.md`": "`Home`",
    "`iridescent-modular-spells-tetra-migration.md`": "`Iridescent-Modular-Spells-Tetra-Migration`"
  },
