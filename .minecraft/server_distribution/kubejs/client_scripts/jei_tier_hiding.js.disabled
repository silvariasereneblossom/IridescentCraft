// =============================================================================
// JEI ITEM VISIBILITY — Client-side tier-based item hiding (FALLBACK)
//
// *** PRIMARY SYSTEM: Use astages_restrictions.js instead ***
// AStages natively hides restricted items from JEI per-player.
// This file is only needed if AStages native JEI integration fails.
// If astages_restrictions.js works, rename this to .js.disabled
//
// KubeJS JEI events are global (not per-player), so we use a hybrid approach:
//   1. At client load: hide ALL tier 2/3/4 items from JEI
//   2. When player gains a tier: re-show those items via reload
//   3. Server sends stage data to client → client updates JEI visibility
//
// NOTE: JEIEvents.hideItems runs at startup and is NOT dynamically reloadable
// per-player. For true per-player hiding, Item Stages mod (CraftTweaker) is
// needed. This script provides a GLOBAL default hiding that works as a
// baseline — items above ALL players' tiers are hidden.
//
// For single-player or same-tier-group servers, this works perfectly.
// For mixed-tier multiplayer, the server-side item_gates.js provides
// enforcement while JEI shows items at the server's highest unlocked tier.
// =============================================================================

// This runs on F3+T reload or game start
JEIEvents.hideItems(event => {
  // ---- TIER 2: Hidden until ANY player unlocks Tier 2 ----
  // These are unhidden once the server flag icraft_tier2_unlocked is set

  // Thermal Series (full mod)
  event.hide(/^thermal:/)

  // Industrial Foregoing (full mod)
  event.hide(/^industrialforegoing:/)

  // Ars Nouveau (full mod)
  event.hide(/^ars_nouveau:/)

  // Twilight Forest materials (not the dimension blocks — just craftable items)
  event.hide('twilightforest:steeleaf_ingot')
  event.hide('twilightforest:ironwood_ingot')
  event.hide('twilightforest:fiery_ingot')
  event.hide('twilightforest:knightmetal_ingot')
  event.hide('twilightforest:fiery_sword')
  event.hide('twilightforest:fiery_pickaxe')

  // Blue Skies materials
  event.hide('blue_skies:pyrope_gem')
  event.hide('blue_skies:aquite')
  event.hide('blue_skies:charoite')
  event.hide('blue_skies:horizonite_ingot')

  // Aether materials
  event.hide('aether:zanite_gemstone')
  event.hide('aether:gravitite')

  // ---- TIER 3: Hidden until Tier 3 unlocked ----

  // Mekanism (full mod)
  event.hide(/^mekanism:/)
  event.hide(/^mekanismgenerators:/)

  // Refined Storage (full mod)
  event.hide(/^refinedstorage:/)
  event.hide(/^extrastorage:/)
  event.hide(/^extradisks:/)
  event.hide(/^rsrequestify:/)

  // Occultism (full mod)
  event.hide(/^occultism:/)

  // Forbidden & Arcanus (full mod)
  event.hide(/^forbidden_arcanus:/)

  // XNet
  event.hide(/^xnet:/)

  // Key materials
  event.hide('minecraft:diamond')
  event.hide('minecraft:diamond_block')
  event.hide('minecraft:diamond_ore')
  event.hide('minecraft:deepslate_diamond_ore')
  event.hide('minecraft:ancient_debris')
  event.hide('botania:terrasteel_ingot')
  event.hide('botania:elementium_ingot')
  event.hide('thermal:enderium_ingot')

  // ---- TIER 4: Hidden until Tier 4 unlocked ----

  // RFTools Dimensions
  event.hide(/^rftoolsdim:/)

  // Mahou Tsukai
  event.hide(/^mahoutsukai:/)

  // RS Infinity Booster
  event.hide(/^rsinfinitybooster:/)

  // Key materials
  event.hide('minecraft:netherite_ingot')
  event.hide('minecraft:netherite_block')
  event.hide('minecraft:netherite_scrap')
  event.hide('botania:gaia_ingot')
  event.hide('mekanism:atomic_alloy')
  event.hide('mekanism:ultimate_control_circuit')

  // Ender storage
  event.hide(/^enderchests:/)
  event.hide(/^enderstorage:/)
  event.hide('endportalrecipe:portal_catalyst')
})

// =============================================================================
// RECIPE HIDING — Hide recipes for tier-gated items
// This prevents players from seeing HOW to make items they can't access yet.
// =============================================================================

JEIEvents.hideRecipes(event => {
  // Hide RS recipes (they'll be visible once tier 3 is reached)
  // The custom dual-path recipes from refined_storage_dualpath.js are hidden
  // along with all default RS recipes until tier 3
  event.hide('minecraft:crafting', /^kubejs:rs_/)
})

// =============================================================================
// NOTE ON DYNAMIC UNHIDING
// =============================================================================
// KubeJS JEI events fire at client startup and aren't dynamically per-player.
// To "unhide" items when a player reaches a new tier:
//
// Option A (Simple): Remove tier sections from this file as the pack progresses.
//   Pack devs can ship "jei_tier2_unlocked.js" etc. that override hiding.
//
// Option B (Item Stages mod): Add Item Stages to the mod list for true
//   per-player JEI hiding with Game Stages integration. This is the
//   recommended approach for multiplayer servers with mixed-tier players.
//
// Option C (Config reload): Server detects tier unlock → tells client to
//   run /kubejs reload client_scripts, which re-evaluates the hide list.
//   Requires the hide list to check a config file for unlocked tiers.
//
// For initial release, Option A is fine. The server-side item_gates.js
// prevents actual USE of gated items regardless of JEI visibility.
