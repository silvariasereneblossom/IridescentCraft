{
  "type": "origins:multiple",
  "name": "Gills",
  "description": "You breathe underwater naturally. On land, you slowly become uncomfortable but won't suffocate. After 5 minutes without water, you get Slowness and Mining Fatigue.",
  "conduit_like": {
    "type": "origins:conditioned_attribute",
    "modifiers": [
      {
        "attribute": "forge:entity_gravity",
        "operation": "multiply_base",
        "value": -0.3,
        "name": "Merling Water Gravity"
      }
    ],
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    }
  },
  "tag_on_gain": {
    "type": "origins:action_on_callback",
    "entity_action_added": {
      "type": "origins:execute_command",
      "command": "tag @s add icraft_merling"
    },
    "entity_action_removed": {
      "type": "origins:execute_command",
      "command": "tag @s remove icraft_merling"
    }
  }
}
