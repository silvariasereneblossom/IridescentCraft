// =============================================================================
// ENFORCEMENT: Prevent equipping/using gated items
// =============================================================================

// Build a map for fast lookup: item → required tier
const ITEM_TIER_MAP = new Map()
TIER_2_ITEMS.forEach(item => ITEM_TIER_MAP.set(item, 'tier_2'))
TIER_3_ITEMS.forEach(item => ITEM_TIER_MAP.set(item, 'tier_3'))
TIER_4_ITEMS.forEach(item => ITEM_TIER_MAP.set(item, 'tier_4'))

// Helper: check if player has required tier
function playerHasTier(player, requiredTier) {
  // tier_1 is default (everyone has it)
  if (requiredTier === 'tier_1') return true
  return player.stages.has(requiredTier)
}

// Helper: get tier display name
function tierName(tier) {
  const names = { 'tier_2': 'Tier 2', 'tier_3': 'Tier 3', 'tier_4': 'Tier 4' }
  return names[tier] || tier
}

// Prevent right-click use of gated items
ItemEvents.rightClicked(event => {
  const itemId = event.item.id
  const requiredTier = ITEM_TIER_MAP.get(itemId)
  if (requiredTier && !playerHasTier(event.player, requiredTier)) {
    event.cancel()
    event.player.tell(
      Text.gold(`⚠ This item requires ${tierName(requiredTier)}. Complete progression quests to unlock.`)
    )
  }
})

// Prevent placing gated blocks
BlockEvents.placed(event => {
  if (!event.player) return
  const itemId = event.player.mainHandItem.id
  const requiredTier = ITEM_TIER_MAP.get(itemId)
  if (requiredTier && !playerHasTier(event.player, requiredTier)) {
    event.cancel()
    event.player.tell(
      Text.gold(`⚠ Cannot place: requires ${tierName(requiredTier)}.`)
    )
  }
})

// Periodic check: warn players holding gated items (every 5 seconds)
// We don't force-unequip (too aggressive) — just warn and prevent functionality
PlayerEvents.tick(event => {
  if (event.player.age % 100 !== 0) return  // every 5 seconds
  const player = event.player

  // Check mainhand
  const mhId = player.mainHandItem.id
  const mhTier = ITEM_TIER_MAP.get(mhId)
  if (mhTier && !playerHasTier(player, mhTier)) {
    player.displayClientMessage(
      Text.gold(`⚠ ${player.mainHandItem.hoverName.string} requires ${tierName(mhTier)}`),
      true  // actionbar
    )
  }
})

// =============================================================================
// RECIPE GATE: Prevent crafting gated items (belt + suspenders with AStages)
// AStages handles this natively via stage-gated recipes, but we add KubeJS
// enforcement as backup for any recipes not caught by AStages.
// =============================================================================

ServerEvents.recipes(event => {
  // Tag all tier-restricted items so AStages can reference them
  // This creates item tags that AStages config can use:
  //   #icraft:tier_2_restricted, #icraft:tier_3_restricted, #icraft:tier_4_restricted
  // AStages config then restricts crafting of tagged items per stage.
  //
  // The actual AStages JSON config goes in:
  //   config/astages-common.toml
  // See astages_config.js for the generated config.
})

console.log(`[IridescentCraft] Item gates loaded: ${ITEM_TIER_MAP.size} items gated`)
console.log(`  Tier 2: ${TIER_2_ITEMS.length} items`)
console.log(`  Tier 3: ${TIER_3_ITEMS.length} items`)
console.log(`  Tier 4: ${TIER_4_ITEMS.length} items`)
