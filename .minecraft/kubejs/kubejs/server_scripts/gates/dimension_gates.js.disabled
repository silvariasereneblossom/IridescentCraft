// =============================================================================
// ASTAGES DIMENSION GATES — Prevent portal travel before tier unlock
// Design Doc Section 4: Dimensional Progression
//
// Dimension → Tier mapping:
//   Tier 1: Overworld (always accessible)
//   Tier 2: Twilight Forest, Blue Skies (Everbright + Everdawn), The Aether
//   Tier 3: Undergarden, Deeper and Darker, The Nether
//   Tier 4: Deep Aether, The End
//
// Implementation: Cancel dimension change events for players without the stage.
// Players get a message explaining what they need to do.
// =============================================================================

const DIMENSION_TIER_MAP = {
  // Tier 2 dimensions
  'twilightforest:twilight_forest':     'tier_2',
  'blue_skies:everbright':              'tier_2',
  'blue_skies:everdawn':                'tier_2',
  'aether:the_aether':                  'tier_2',

  // Tier 3 dimensions
  'undergarden:undergarden':            'tier_3',
  'deeperdarker:otherside':             'tier_3',
  'minecraft:the_nether':               'tier_3',
  'theabyss:the_abyss':                 'tier_3',

  // Tier 4 dimensions
  'deep_aether:the_aether':             'tier_4',
  'minecraft:the_end':                  'tier_4',
}

const DIMENSION_DISPLAY_NAMES = {
  'twilightforest:twilight_forest':     'the Twilight Forest',
  'blue_skies:everbright':              'Everbright',
  'blue_skies:everdawn':                'Everdawn',
  'aether:the_aether':                  'the Aether',
  'undergarden:undergarden':            'the Undergarden',
  'deeperdarker:otherside':             'the Otherside',
  'minecraft:the_nether':               'the Nether',
  'theabyss:the_abyss':                 'the Abyss',
  'deep_aether:the_aether':             'the Deep Aether',
  'minecraft:the_end':                  'the End',
}

const TIER_HINTS = {
  'tier_2': 'Complete any Tier 2 gate quest, or kill a Tier 2 boss, or craft a Thermal Machine Frame.',
  'tier_3': 'Complete any Tier 3 gate quest, or kill a Tier 3 boss, or craft a Mekanism Steel Casing.',
  'tier_4': 'Complete any Tier 4 gate quest, or kill the Ender Dragon/Gaia Guardian, or craft an Ultimate Control Circuit.',
}

// =============================================================================
// PORTAL PREVENTION — Cancel dimension change for ungated players
// =============================================================================

PlayerEvents.changeDimension(event => {
  const destDim = event.toLevel.dimension.toString()
  const requiredTier = DIMENSION_TIER_MAP[destDim]

  if (!requiredTier) return  // Untracked dimension, allow

  if (!event.player.stages.has(requiredTier)) {
    event.cancel()

    const dimName = DIMENSION_DISPLAY_NAMES[destDim] || destDim
    const hint = TIER_HINTS[requiredTier] || ''
    const tierNum = requiredTier.replace('tier_', '')

    event.player.tell(Text.red(`✘ You cannot enter ${dimName} yet.`))
    event.player.tell(Text.gold(`  Requires: Tier ${tierNum} progression.`))
    if (hint) {
      event.player.tell(Text.gray(`  Hint: ${hint}`))
    }
  }
})

// =============================================================================
// PORTAL BLOCK PREVENTION — Prevent building/activating portals
// For Nether portals specifically, prevent flint & steel on obsidian frame
// if player lacks tier_3.
// =============================================================================

ItemEvents.rightClicked(event => {
  const item = event.item
  const player = event.player

  // Flint & steel portal activation check
  if (item.id === 'minecraft:flint_and_steel') {
    // Check if clicking on obsidian (potential Nether portal)
    const target = event.target
    if (target && target.block) {
      const block = target.block
      if (block.id === 'minecraft:obsidian' && !player.stages.has('tier_3')) {
        // Don't cancel flint & steel entirely — only warn.
        // The changeDimension event will catch the actual teleport.
        // This is just a courtesy message.
      }
    }
  }
})

// =============================================================================
// LOGGING
// =============================================================================

console.log(`[IridescentCraft] Dimension gates loaded: ${Object.keys(DIMENSION_TIER_MAP).length} dimensions gated`)
console.log('  Tier 2: Twilight Forest, Blue Skies, Aether')
console.log('  Tier 3: Undergarden, Deeper Darker, Nether, The Abyss')
console.log('  Tier 4: Deep Aether, The End')
